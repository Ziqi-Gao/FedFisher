{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FedFisher survival v1 pilot-gated formal shard parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["cell", "scenario", "shard_index", "shard_count"],
  "properties": {
    "cell": {"type": "string", "enum": ["dslasso", "fedfisher_diag_shallow", "fedfisher_diag_deep", "fedfisher_kfac_shallow", "fedfisher_kfac_deep"]},
    "scenario": {"type": "string", "enum": ["iid", "covariate_shift"]},
    "shard_index": {"type": "integer", "minimum": 0, "maximum": 15},
    "shard_count": {"type": "integer", "enum": [8, 16]}
  },
  "allOf": [{"if": {"properties": {"shard_count": {"const": 8}}},
             "then": {"properties": {"shard_index": {"maximum": 7}}}}]
}
