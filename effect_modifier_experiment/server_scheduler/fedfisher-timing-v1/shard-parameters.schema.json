{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FedFisher timing-shard scientific parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "variant",
    "cell",
    "shard_index",
    "shard_count"
  ],
  "properties": {
    "variant": {
      "enum": [
        "control",
        "site_gaussian_shift",
        "local_permutation",
        "site_gaussian_local_permutation"
      ]
    },
    "cell": {
      "enum": [
        "fedfisher_diag_shallow",
        "fedfisher_kfac_shallow",
        "fedfisher_diag_deep",
        "fedfisher_kfac_deep"
      ]
    },
    "shard_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "shard_count": {
      "type": "integer",
      "enum": [
        8,
        16
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "shard_count": {
            "const": 8
          }
        }
      },
      "then": {
        "properties": {
          "shard_index": {
            "maximum": 7
          }
        }
      }
    }
  ]
}
